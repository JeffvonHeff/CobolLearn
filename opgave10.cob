       IDENTIFICATION DIVISION.
       PROGRAM-ID. Opgave10.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SPECIAL-NAMES.
           DECIMAL-POINT IS COMMA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT BANKFIL ASSIGN TO "Banker.txt"
           ORGANIZATION IS LINE SEQUENTIAL.
           SELECT TRANSAKTIONFIL ASSIGN TO "Transaktioner.txt"
           ORGANIZATION IS LINE SEQUENTIAL.
           SELECT OUT-FIL ASSIGN TO "Kontoudskrifter.txt"
           ORGANIZATION IS LINE SEQUENTIAL.
       DATA DIVISION.
       FILE SECTION.
       FD BANKFIL.
       01 BANK-REKORD.
       COPY "BANKS.cpy".

       FD  TRANSAKTIONFIL.
       01 TRANSAKTIONER-REKORD.
       COPY "TRANSACTIONS.cpy".

       FD OUT-FIL.
       01 OUT-REKORD.
         02 OUTPUT-TEXT PIC X(150).

       WORKING-STORAGE SECTION.
       01 BANK-COUNT PIC 9(3) VALUE 0.
       01 EOF-TRANSAKTION PIC X VALUE "N".
       88 END-TRANSAKTION VALUE "Y".
       88 MORE-TRANSAKTION VALUE "N".
       01 EOF-BANK PIC X VALUE "N".
       88 END-BANK VALUE "Y".
       01 IX-KONTI PIC 9(3) VALUE 1.


       01 PREVIOUSNAVN PIC X(30) VALUE SPACES.
       01 CURRENTNAVN PIC X(30) VALUE SPACES.
       01 VALUTA-RATE PIC 9V9 VALUE 1,0.
       01 BELOB-DKK PIC 9(13)V99 VALUE 0.
       01 BELOB-DKK-DISP PIC ZZ,ZZZ,ZZZ,ZZ9.99 VALUE 0.
       
       
       *> Array til Bank på 01 niveau
       01 BANK-ARRAY OCCURS 100 TIMES.
       COPY "BANKS.cpy".
       PROCEDURE DIVISION.
       MAIN-PROGRAM.
           MOVE "Current" TO CURRENTNAVN
           MOVE "Previous" TO PREVIOUSNAVN
       *> Læs TRANSAKTIONFILen ind i array
  
       OPEN INPUT BANKFIL
           MOVE 1 TO BANK-COUNT
           MOVE "N" TO EOF-BANK
       PERFORM UNTIL END-BANK
               READ BANKFIL
           AT END
               SET END-BANK TO TRUE
           NOT AT END
               MOVE BANK-REKORD TO BANK-ARRAY(BANK-COUNT)
               ADD 1 TO BANK-COUNT
           END-READ
       END-PERFORM
           CLOSE BANKFIL
       
       OPEN INPUT TRANSAKTIONFIL
       OPEN OUTPUT OUT-FIL
       *> Læs TRANSAKTIONER og match med konti i array
       PERFORM UNTIL END-TRANSAKTION
           READ TRANSAKTIONFIL
           AT END
               SET END-TRANSAKTION TO TRUE
           NOT AT END
               MOVE NAVN OF TRANSAKTIONER-REKORD TO CURRENTNAVN
               IF CURRENTNAVN NOT = PREVIOUSNAVN
                   PERFORM MATCH-NAME-AND-BANK
               END-IF
               PERFORM ONLYTRANSAKTION
               MOVE CURRENTNAVN TO PREVIOUSNAVN
               MOVE SPACES TO OUTPUT-TEXT
               WRITE OUT-REKORD
               END-READ
       END-PERFORM
           CLOSE TRANSAKTIONFIL
           CLOSE OUT-FIL
       STOP RUN.
       *> -------------------
       *> Formateringsparagraffer

 
       EXIT.
       MATCH-NAME-AND-BANK.
       PERFORM VARYING IX-KONTI FROM 1 BY 1 UNTIL IX-KONTI >=
       BANK-COUNT
       IF REG-NR OF BANK-ARRAY(IX-KONTI) = REG-NR OF 
       TRANSAKTIONER-REKORD
       MOVE SPACES TO OUTPUT-TEXT
           STRING "Kunde: " NAVN OF TRANSAKTIONER-REKORD
           INTO OUTPUT-TEXT
       END-STRING
       WRITE OUT-REKORD
       MOVE SPACES TO OUTPUT-TEXT
           STRING "Adresse: " ADRESSE OF TRANSAKTIONER-REKORD
           INTO OUTPUT-TEXT
       END-STRING
       WRITE OUT-REKORD
       MOVE SPACES TO OUTPUT-TEXT
       MOVE NAVN OF TRANSAKTIONER-REKORD TO CURRENTNAVN
       STRING "Registreringsnummer: " REG-NR OF BANK-ARRAY(IX-KONTI)
           DELIMITED BY SIZE
           INTO OUTPUT-TEXT
       END-STRING
       WRITE OUT-REKORD
       MOVE SPACES TO OUTPUT-TEXT
       
       STRING "Bank: " BANKNAVN OF BANK-ARRAY(IX-KONTI)
           DELIMITED BY SIZE
           INTO OUTPUT-TEXT
       END-STRING
       WRITE OUT-REKORD
       MOVE SPACES TO OUTPUT-TEXT
       
       STRING "Bankadresse: " BANKADRESSE OF BANK-ARRAY(IX-KONTI)
           DELIMITED BY SIZE
           INTO OUTPUT-TEXT
       END-STRING
       WRITE OUT-REKORD
       MOVE SPACES TO OUTPUT-TEXT
       
       STRING "Telefon: " TELEFON OF BANK-ARRAY(IX-KONTI)
           DELIMITED BY SIZE
           INTO OUTPUT-TEXT
       END-STRING
       WRITE OUT-REKORD
       MOVE SPACES TO OUTPUT-TEXT
       
       STRING "E-mail: " EMAIL OF BANK-ARRAY(IX-KONTI)
           DELIMITED BY SIZE
           INTO OUTPUT-TEXT
       END-STRING
       WRITE OUT-REKORD
       MOVE SPACES TO OUTPUT-TEXT
       
       STRING "Kontoudskrift for kontonr.: " KONTO-ID OF
       TRANSAKTIONER-REKORD
           DELIMITED BY SIZE
           INTO OUTPUT-TEXT
       END-STRING
       WRITE OUT-REKORD
       MOVE SPACES TO OUTPUT-TEXT

       END-IF
       END-PERFORM
       EXIT.

       ONLYTRANSAKTION.
       PERFORM VARYING IX-KONTI FROM 1 BY 1 UNTIL IX-KONTI >=
       BANK-COUNT
       IF REG-NR OF BANK-ARRAY(IX-KONTI) = REG-NR OF 
       TRANSAKTIONER-REKORD
       MOVE 1,0 TO VALUTA-RATE
       IF VALUTA OF TRANSAKTIONER-REKORD(1:3) = "USD"
           MOVE 6,8 TO VALUTA-RATE
       ELSE
           IF VALUTA OF TRANSAKTIONER-REKORD(1:3) = "EUR"
               MOVE 7,5 TO VALUTA-RATE
           END-IF
       END-IF
       COMPUTE BELOB-DKK = BELOB OF TRANSAKTIONER-REKORD *
           VALUTA-RATE
       MOVE BELOB-DKK TO BELOB-DKK-DISP
       MOVE SPACES TO OUTPUT-TEXT
              STRING "Dato: " TIDSPUNKT OF TRANSAKTIONER-REKORD
       " Transaktionstype: " TRANSAKTIONSTYPE OF TRANSAKTIONER-REKORD
       " Beløb (DKK): " BELOB-DKK-DISP
       " Butik: " BUTIK OF TRANSAKTIONER-REKORD
           DELIMITED BY SIZE
           INTO OUTPUT-TEXT
       END-STRING
       WRITE OUT-REKORD

       END-IF
       END-PERFORM
       EXIT.
